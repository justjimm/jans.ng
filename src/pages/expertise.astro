---
import Base from '../layouts/Base.astro';
import Groups from '../components/Groups.astro';
---
<Base title="Expertise" description="JANS practises across three groups: Dispute Resolution; Transactions & Advisory; and Workplace, Regulatory & Private Client. What each practice covers and which partner leads it.">
  <section class="phead">
    <div class="wrap">
      <p class="kicker">Expertise</p>
      <h1>Three practice groups</h1>
      <p class="lede">Our work falls into three practice groups. Most clients need more than one, so our partners work across all three. Each practice below has a named lead partner.</p>
    </div>
  </section>
  <section class="sec">
    <div class="wrap">
      <Groups full headingLevel="h2" />
      <div class="ctas" style="margin-top:48px">
        <a class="btn btn-outline" href="/sectors/">Sectors we advise</a>
        <a class="btn btn-dark" href="/contact/">Speak to us</a>
      </div>
    </div>
  </section>
</Base>
